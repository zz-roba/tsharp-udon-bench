<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs every benchmark body under plain .NET and writes expected.json. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0414;CS0169;CS0649;CS1717</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Stubs.cs;Program.cs;Generated/*.cs" />
  </ItemGroup>
</Project>
